numeros = [10, 25, 7, 42, 18, 33, 5, 29, 14, 50]

valor = int(input("Digite um número: "))

encontrado = False

for i in range(len(numeros)):
    if numeros[i] == valor:
        encontrado = True
        break

if encontrado:
    print("O número está presente na lista.")
else:
    print("O número não está presente na lista.")
