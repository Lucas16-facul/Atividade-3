numeros = []

for i in range(2, 201, 2):
    numeros.append(i)

valor = int(input("Digite um número: "))

inicio = 0
fim = len(numeros) - 1

while inicio <= fim:
    meio = (inicio + fim) // 2

    if numeros[meio] == valor:
        print("Número encontrado na posição:", meio)
        break

    elif valor < numeros[meio]:
        fim = meio - 1

    else:
        inicio = meio + 1
else:
    print("Número não encontrado.")
