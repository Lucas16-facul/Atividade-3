import random

numeros = []

for i in range(20):
    numeros.append(random.randint(1, 10))

print("Lista:", numeros)

valor = int(input("Digite um valor: "))

posicoes = []

for i in range(len(numeros)):
    if numeros[i] == valor:
        posicoes.append(i)

if len(posicoes) > 0:
    print("O valor aparece nas posições:", posicoes)
else:
    print("O valor não foi encontrado.")
