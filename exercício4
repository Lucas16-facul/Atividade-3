notas = [7.5, 8.0, 9.0, 7.5, 6.5, 8.0, 7.5]

nota = float(input("Digite a nota procurada: "))

quantidade = 0

for i in range(len(notas)):
    if notas[i] == nota:
        quantidade += 1

if quantidade > 0:
    print("A nota aparece na lista.")
    print("Quantidade de ocorrências:", quantidade)
else:
    print("A nota não aparece na lista.")
